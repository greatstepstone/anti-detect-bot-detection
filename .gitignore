# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of a library, parsing of Pipfile.lock is not supported by Setup.py
#   which is why Pipfile.lock can be excluded.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be committed
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be committed
#pdm.lock
#   pdm build stage
.pdm-build/

# PEP 582; project local dependency directory
